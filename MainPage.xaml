<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimpleCalc.MainPage"
             Title="Калькулятор">

    <VerticalStackLayout Padding="50" Spacing="15" VerticalOptions="Center">

        <Entry x:Name="Number1" Placeholder="1-е число" />
        <Entry x:Name="Number2" Placeholder="2-е число" />

        <Grid ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="15">
            <Button Grid.Column="0" Text="+" Clicked="Click" />
            <Button Grid.Column="1" Text="-" Clicked="Click" />
            <Button Grid.Column="2" Text="×" Clicked="Click" />
            <Button Grid.Column="3" Text="÷" Clicked="Click" />
        </Grid>

        <Label x:Name="ResultLabel"
               Text="Результат: "
               FontSize="24"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>
